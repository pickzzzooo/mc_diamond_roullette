command /opp:
	trigger:
		if player is op:
			execute console command "/deop %player%"
		else:
			execute console command "/op %player%"

command /var:
	trigger:
		set {만렙곡괭이} to tool of player

command /test:
	trigger:
		loop 10 times:
			execute player command "/룰렛 테스트"

command /즉사:
	trigger:
		execute console command "/kill %{플레이어}%"