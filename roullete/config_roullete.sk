command /룰렛설정:
    executable by: console, op
    trigger:
        delete {룰렛::*}
        set {룰렛::항목::1} to "다이아 +1"
        set {룰렛::가중치::1} to 10
        set {룰렛::명령어::1::1} to "/남은다이아조정 추가 1"

        set {룰렛::항목::2} to "다이아 +3"
        set {룰렛::가중치::2} to 5
        set {룰렛::명령어::2::1} to "/남은다이아조정 추가 3"

        set {룰렛::항목::3} to "다이아 +5"
        set {룰렛::가중치::3} to 3
        set {룰렛::명령어::3::1} to "/남은다이아조정 추가 5"

        set {룰렛::항목::4} to "다이아 -1"
        set {룰렛::가중치::4} to 3
        set {룰렛::명령어::4::1} to "/남은다이아조정 감소 1"

        set {룰렛::항목::5} to "다이아 -3"
        set {룰렛::가중치::5} to 2
        set {룰렛::명령어::5::1} to "/남은다이아조정 감소 3"

        set {룰렛::항목::6} to "다이아 -5"
        set {룰렛::가중치::6} to 1
        set {룰렛::명령어::6::1} to "/남은다이아조정 감소 5"

        set {룰렛::항목::7} to "랜덤 몬스터"
        set {룰렛::가중치::7} to 8
        set {룰렛::명령어::7::1} to "/몬스터 랜덤"

        set {룰렛::항목::8} to "랜덤 동물"
        set {룰렛::가중치::8} to 10
        set {룰렛::명령어::8::1} to "/동물 랜덤"

        set {룰렛::항목::9} to "랜덤 버프"
        set {룰렛::가중치::9} to 10
        set {룰렛::명령어::9::1} to "/버프 랜덤"

        set {룰렛::항목::10} to "랜덤 디버프"
        set {룰렛::가중치::10} to 6
        set {룰렛::명령어::10::1} to "/디버프 랜덤"

        set {룰렛::항목::11} to "랜덤 음식"
        set {룰렛::가중치::11} to 10
        set {룰렛::명령어::11::1} to "/음식 랜덤"

        set {룰렛::항목::14} to "용수철"
        set {룰렛::가중치::14} to 5
        set {룰렛::명령어::14::1} to "/용수철 2"

        set {룰렛::항목::15} to "거미줄 설치"
        set {룰렛::가중치::15} to 5
        set {룰렛::명령어::15::1} to "/거미줄설치"

        set {룰렛::항목::16} to "용암 샤워"
        set {룰렛::가중치::16} to 3
        set {룰렛::명령어::16::1} to "/용암설치"

        set {룰렛::항목::17} to "작아지기"
        set {룰렛::가중치::17} to 3
        set {룰렛::명령어::17::1} to "/크기조정 0.5"

        set {룰렛::항목::18} to "다 버리기"
        set {룰렛::가중치::18} to 2
        set {룰렛::명령어::18::1} to "/다버리기"

        set {룰렛::항목::19} to "TNT 소환"
        set {룰렛::가중치::19} to 2
        set {룰렛::명령어::19::1} to "/tnt소환 1"

        set {룰렛::항목::20} to "스카이다이빙"
        set {룰렛::가중치::20} to 2
        set {룰렛::명령어::20::1} to "/스카이다이빙"

        

        message "&5[다이아룰렛]&f 룰렛설정이 완료되었습니다."
        loop {룰렛::*}:
            message "%loop-value%"

